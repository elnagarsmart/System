<Window x:Class="CardMaster.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CardMaster | كارد ماستر" Height="780" Width="1120"
        MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FlowDirection="RightToLeft">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="CardMaster" FontSize="34" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="منصة تشخيص قارئات البطاقات وNFC على Windows" FontSize="16" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
            </StackPanel>
            <Border HorizontalAlignment="Left" VerticalAlignment="Center" Background="#1D2940" CornerRadius="18" Padding="14,8">
                <TextBlock Text="إصدار الكمبيوتر" Foreground="#8DE1C5"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="#303653" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="قارئات البطاقات المتصلة" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="يعرض قارئات PC/SC التي يتعرف عليها Windows، سواء كانت قارئ Smart Card أو قارئ NFC متوافقًا." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="تحديث القارئات" Click="RefreshReaders_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#303653" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="الأجهزة" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <ListBox x:Name="ReadersList" Height="300" Background="#101426" Foreground="{StaticResource TextBrush}" BorderBrush="#343B5C" SelectionChanged="ReadersList_SelectionChanged"/>
                        <Button Content="فحص البطاقة المحددة" Click="ScanCard_Click" Margin="0,14,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="ReaderHint" DockPanel.Dock="Bottom" Text="وصّل قارئ بطاقات متوافقًا ثم اضغط تحديث القارئات." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="#303653" BorderThickness="1" CornerRadius="18" Padding="20" Margin="12,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="نتيجة التشخيص" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusText" Text="جاهز للفحص. لم يتم إرسال أي أوامر إلى البطاقة." Foreground="{StaticResource AccentBrush}" FontSize="16" TextWrapping="Wrap" Margin="0,12,0,18"/>
                        <Separator Background="#343B5C"/>
                        <TextBlock Text="القارئ المحدد" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,4"/>
                        <TextBlock x:Name="SelectedReaderText" Text="لا يوجد قارئ محدد" TextWrapping="Wrap"/>
                        <TextBlock Text="حالة البطاقة" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,4"/>
                        <TextBlock x:Name="CardStateText" Text="لم يتم الفحص بعد" TextWrapping="Wrap"/>
                        <TextBlock Text="بيانات ATR العامة" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,4"/>
                        <TextBox x:Name="AtrText" IsReadOnly="True" Text="—" Background="#101426" Foreground="#B9A3FF" BorderBrush="#343B5C" Padding="10" TextWrapping="Wrap"/>
                        <TextBlock Text="بروتوكول الاتصال" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,4"/>
                        <TextBlock x:Name="ProtocolText" Text="—"/>
                        <Border Background="#20243A" CornerRadius="12" Padding="14" Margin="0,22,0,0">
                            <TextBlock Text="ملاحظة: فتحة Smart Card التقليدية ليست بالضرورة NFC. لقراءة NFC لاسلكيًا قد تحتاج قارئ USB NFC يدعم PC/SC. هذا الإصدار يعرض معلومات التعريف العامة فقط ولا يقرأ بيانات محمية أو يغيّرها." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="CardMaster مستقل عن Academia • لا يتم حفظ رقم البطاقة أو محتواها" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
    </Grid>
</Window>
